{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-selection.schema.json",
  "title": "Trade family selection",
  "description": "Which trade families the server fetches. A hidden family is not requested.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "freight", "supply-chain"],
  "properties": {
    "policy": { "$ref": "#/$defs/family" },
    "freight": { "$ref": "#/$defs/family" },
    "supply-chain": { "$ref": "#/$defs/family" }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
