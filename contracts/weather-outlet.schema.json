{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather-outlet.schema.json",
  "title": "Weather-news outlet",
  "description": "One public weather-news RSS feed. The server is the only process that fetches it. This is not an observation or a forecast.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "fetch", "enabled", "note"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "fetch": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "note": { "type": "string", "minLength": 1 }
  }
}
