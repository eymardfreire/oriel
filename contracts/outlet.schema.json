{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outlet.schema.json",
  "title": "Wire outlet",
  "description": "One public RSS or Atom source. The server is the only process that fetches it. Last successful fetch is recorded in server state, not in this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "fetch", "language", "region", "desks", "enabled"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Shown on each headline row."
    },
    "fetch": {
      "type": "string",
      "minLength": 1,
      "description": "Public http(s) RSS or Atom URL."
    },
    "language": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "desks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["world", "regional", "business", "politics", "technology", "science"]
      }
    },
    "enabled": {
      "type": "boolean",
      "description": "When false the server does not fetch this outlet and omits it after the next successful refresh."
    }
  }
}
