{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desk.schema.json",
  "title": "Desk",
  "description": "A named list of bays. The launcher starts one process per bay and prints each role. It does not tile OS windows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "bays"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "bays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Bay id. Matches a file in catalog/bays/."
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Intended role in the arrangement. Printed by the launcher. Not a window position."
          }
        }
      }
    }
  }
}
