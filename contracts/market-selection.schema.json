{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-selection.schema.json",
  "title": "Market selection",
  "description": "Operator choice of families and instruments. A hidden family is not fetched. A panel does not add an instrument that is absent here, except crypto when top asks CoinGecko for that many coins by market cap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["indices", "sectors", "equities", "london", "europe", "tokyo", "hongkong", "china", "india", "brazil", "canada", "korea", "taiwan", "australia", "funds", "fx", "rates", "bonds", "commodities", "crypto"],
  "properties": {
    "indices": { "$ref": "#/$defs/family" },
    "sectors": { "$ref": "#/$defs/family" },
    "equities": { "$ref": "#/$defs/family" },
    "london": { "$ref": "#/$defs/family" },
    "europe": { "$ref": "#/$defs/family" },
    "tokyo": { "$ref": "#/$defs/family" },
    "hongkong": { "$ref": "#/$defs/family" },
    "china": { "$ref": "#/$defs/family" },
    "india": { "$ref": "#/$defs/family" },
    "brazil": { "$ref": "#/$defs/family" },
    "canada": { "$ref": "#/$defs/family" },
    "korea": { "$ref": "#/$defs/family" },
    "taiwan": { "$ref": "#/$defs/family" },
    "australia": { "$ref": "#/$defs/family" },
    "funds": { "$ref": "#/$defs/family" },
    "fx": { "$ref": "#/$defs/family" },
    "rates": { "$ref": "#/$defs/family" },
    "bonds": { "$ref": "#/$defs/family" },
    "commodities": { "$ref": "#/$defs/family" },
    "crypto": { "$ref": "#/$defs/family" }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "instruments"],
      "properties": {
        "enabled": { "type": "boolean" },
        "top": { "type": "integer", "minimum": 0, "maximum": 250 },
        "instruments": {
          "type": "array",
          "items": { "$ref": "#/$defs/instrument" }
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "title"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 3, "maxLength": 3 },
        "counter": { "type": "string", "minLength": 3, "maxLength": 3 },
        "field": { "type": "string", "minLength": 1 }
      }
    }
  }
}
